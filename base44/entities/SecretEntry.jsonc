{
  "name": "SecretEntry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "api_key",
        "db_credential",
        "oauth_token",
        "encryption_key",
        "certificate",
        "webhook_secret"
      ],
      "default": "api_key"
    },
    "environment": {
      "type": "string",
      "enum": [
        "all",
        "development",
        "staging",
        "production"
      ],
      "default": "all"
    },
    "rotation_policy": {
      "type": "string",
      "enum": [
        "never",
        "30d",
        "60d",
        "90d",
        "180d"
      ],
      "default": "90d"
    },
    "last_rotated": {
      "type": "string",
      "format": "date"
    },
    "expires_at": {
      "type": "string",
      "format": "date"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "access_count": {
      "type": "number",
      "default": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "key",
    "type"
  ]
}