{
  "name": "DomainEvent",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "enum": [
        "inventory",
        "sales",
        "purchasing",
        "manufacturing",
        "finance",
        "logistics",
        "crm",
        "platform"
      ]
    },
    "aggregate_id": {
      "type": "string"
    },
    "aggregate_type": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "published",
        "consumed",
        "failed",
        "replaying"
      ],
      "default": "pending"
    },
    "consumer_count": {
      "type": "number",
      "default": 0
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "domain"
  ]
}