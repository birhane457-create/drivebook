{
  "name": "KnowledgeArticle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "glossary",
        "policy",
        "sop",
        "faq",
        "guide"
      ],
      "default": "sop"
    },
    "content": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "module": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "author": {
      "type": "string"
    },
    "embedding_vector": {
      "type": "string"
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "title",
    "type",
    "content"
  ]
}