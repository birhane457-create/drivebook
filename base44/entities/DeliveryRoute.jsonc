{
  "name": "DeliveryRoute",
  "type": "object",
  "properties": {
    "route_number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "driver_phone": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "dispatched",
        "in_transit",
        "completed",
        "failed"
      ],
      "default": "planned"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "departure_time": {
      "type": "string"
    },
    "arrival_time": {
      "type": "string"
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stop_order": {
            "type": "number"
          },
          "customer_name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "sale_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "delivered",
              "failed",
              "partial"
            ]
          },
          "pod_signature": {
            "type": "string"
          },
          "pod_photo_url": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "delivered_at": {
            "type": "string"
          }
        }
      }
    },
    "total_stops": {
      "type": "number",
      "default": 0
    },
    "completed_stops": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ]
}