{
  "name": "AccountsPayable",
  "type": "object",
  "properties": {
    "bill_number": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "po_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "received",
        "partial",
        "paid",
        "overdue",
        "void"
      ],
      "default": "draft"
    },
    "bill_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "balance_due": {
      "type": "number",
      "default": 0
    },
    "currency_code": {
      "type": "string",
      "default": "USD"
    },
    "cost_center_id": {
      "type": "string"
    },
    "payment_terms": {
      "type": "string",
      "enum": [
        "immediate",
        "net_7",
        "net_15",
        "net_30",
        "net_60",
        "net_90"
      ],
      "default": "net_30"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "supplier_id",
    "total_amount"
  ]
}