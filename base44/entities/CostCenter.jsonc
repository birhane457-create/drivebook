{
  "name": "CostCenter",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "cost_center",
        "profit_center",
        "investment_center"
      ],
      "default": "cost_center"
    },
    "parent_id": {
      "type": "string"
    },
    "manager": {
      "type": "string"
    },
    "budget": {
      "type": "number",
      "default": 0
    },
    "actual_spend": {
      "type": "number",
      "default": 0
    },
    "revenue": {
      "type": "number",
      "default": 0
    },
    "company_id": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "name"
  ]
}