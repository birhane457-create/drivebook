{
  "name": "CycleCount",
  "type": "object",
  "properties": {
    "count_number": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_to": {
      "type": "string"
    },
    "abc_class": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "all"
      ],
      "default": "all",
      "description": "Which ABC class to count"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "expected_quantity": {
            "type": "number"
          },
          "counted_quantity": {
            "type": "number"
          },
          "variance": {
            "type": "number"
          },
          "is_counted": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "total_variance": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "location_id",
    "scheduled_date"
  ]
}