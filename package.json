{
  "name": "driving-instructor-platform",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "set NODE_OPTIONS=--max-old-space-size=8192 --dns-result-order=ipv6first && next dev -H 0.0.0.0",
    "build": "prisma generate && set NODE_OPTIONS=--max-old-space-size=8192 && next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "cap:sync": "npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "mobile:dev": "npm run dev",
    "mobile:build": "npm run build && npm run cap:sync",
    "mobile:test:emulator": "echo Testing on emulator - Server at localhost:3000 && npm run dev",
    "mobile:test:device": "echo Testing on device - Update capacitor.config.ts with your IP && npm run dev"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^7.6.0",
    "@capacitor/core": "^8.2.0",
    "@capacitor/ios": "^8.2.0",
    "@googlemaps/js-api-loader": "^1.16.6",
    "@hookform/resolvers": "^3.3.4",
    "@prisma/client": "^5.14.0",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.8.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.9",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.379.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.7",
    "nodemailer": "^7.0.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.4",
    "resend": "^3.2.0",
    "stripe": "^20.3.1",
    "tailwind-merge": "^2.3.0",
    "twilio": "^5.12.2",
    "typescript": "^5.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.3",
    "postcss": "^8.4.38",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.3"
  },
  "capacitor": {
    "note": "Run install-capacitor.bat to install Capacitor dependencies",
    "dependencies": [
      "@capacitor/core",
      "@capacitor/cli",
      "@capacitor/ios",
      "@capacitor/android",
      "@capacitor/push-notifications",
      "@capacitor/geolocation",
      "@capacitor/camera",
      "@capacitor/local-notifications",
      "@capacitor/haptics",
      "@capacitor/splash-screen"
    ]
  }
}
