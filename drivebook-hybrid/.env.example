# ============================================================
# drivebook-hybrid — Voice Service Environment Variables
# Copy this file to .env and fill in your values.
# This is a SEPARATE service from the main DriveBook app.
# ============================================================

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database (SQLite for local dev, PostgreSQL for production) ────────────────
# Local dev (SQLite — zero setup):
DATABASE_URL="file:./prisma/dev.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/drivebook_hybrid?sslmode=require"

# ── Main DriveBook App Connection ─────────────────────────────────────────────
# URL of the main Next.js app that this voice service proxies to
DRIVEBOOK_BASE_URL="http://localhost:3000"
# Internal API key — must match VOICE_SERVICE_API_KEY in the main app's .env
DRIVEBOOK_API_KEY="generate-with-openssl-rand-hex-32"

# ── Twilio (required for voice calls and SMS) ─────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+61400000000"

# Skip Twilio signature validation in development (never set true in production)
SKIP_TWILIO_VALIDATION=false

# ── AI Copilot Agent ──────────────────────────────────────────────────────────
# Base URL of the copilot/AI agent service that handles the voice conversation
COPILOT_BASE_URL="http://localhost:3002"
# Timeout for copilot API calls in milliseconds
COPILOT_TIMEOUT_MS=5000

# ── Redis (optional — for persistent voice sessions across restarts) ──────────
# Without this, voice sessions use in-process Map (lost on restart).
# For multi-instance deployments, Redis is required.
# Free tier: https://console.upstash.com
REDIS_URL="redis://localhost:6379"
# Or Upstash:
# REDIS_URL="rediss://default:your-token@your-db.upstash.io:6379"

# ── Voice Service Configuration ───────────────────────────────────────────────
# Maximum voicemail recording length in seconds
VOICEMAIL_MAX_LENGTH=120
# SMS rate limit — max messages per window
MESSAGE_RATE_LIMIT=5
MESSAGE_RATE_WINDOW_HOURS=1
# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# ── Security ──────────────────────────────────────────────────────────────────
# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
# Internal API key for accessing service docs
INTERNAL_API_KEY="generate-with-openssl-rand-hex-32"
