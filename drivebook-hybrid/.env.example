# ============================================================
# drivebook-hybrid  Voice Service Environment Variables
# Copy this file to .env and fill in your values.
# This is a SEPARATE service from the main DriveBook app.
# ============================================================

#  Server ─
PORT=3001
NODE_ENV=development

#  Database 
# Local dev (SQLite  zero setup):
DATABASE_URL="file:./prisma/dev.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://user:password@host:5432/drivebook_hybrid?sslmode=require"

#  Main DriveBook App Connection 
# URL of the main Next.js app that this voice service proxies to.
# ⚠️  PRODUCTION: must be the real Vercel URL — NOT localhost.
# If this is wrong, all voice API calls will silently fail (Railway can't reach localhost).
DRIVEBOOK_BASE_URL="https://drivebook.com.au"
# Internal API key  must match VOICE_SERVICE_API_KEY in the main app's .env
# REQUIRED IN PRODUCTION. Generate with: openssl rand -hex 32
DRIVEBOOK_API_KEY="generate-with-openssl-rand-hex-32"

#  Twilio (SMS delivery) 
# REQUIRED IN PRODUCTION when SMS is enabled.
# Vapi owns the voice call  Twilio is only used here for outbound SMS
# (payment links, booking confirmations, session recovery).
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+61400000000"

# Skip Twilio signature validation in development (NEVER set true in production)
SKIP_TWILIO_VALIDATION=false

#  Vapi (AI voice agent) 
# Vapi owns the phone call and calls this service's API endpoints as tools.
# Configure the phone number and assistant in the Vapi dashboard.
# Run: node create-vapi-assistant.js YOUR_VAPI_PRIVATE_KEY  (once, to provision)
VAPI_API_KEY="your-vapi-private-key"
VAPI_ASSISTANT_ID="your-vapi-assistant-id"

# Shared secret for verifying inbound Vapi tool calls.
# Set this value in: Vapi Dashboard → Assistant → Server URL → Secret
# Then copy the SAME value here.
# REQUIRED IN PRODUCTION. Generate with: openssl rand -hex 32
VAPI_WEBHOOK_SECRET="generate-with-openssl-rand-hex-32"

#  Redis (optional  for persistent voice sessions) 
# Without this, voice sessions use in-process Map (lost on restart).
# Required for multi-instance deployments (Railway, Render, Fly.io).
# Free tier: https://console.upstash.com
REDIS_URL="redis://localhost:6379"
# Or Upstash:
# REDIS_URL="rediss://default:your-token@your-db.upstash.io:6379"

#  Session configuration 
# How long a voice session is held for call-back recovery (seconds).
# Must match the Stripe checkout window (default 600 = 10 minutes).
SESSION_TTL_SECONDS=600

#  Proxy & timeout configuration 
# Timeout for outbound proxy calls to the main app (ms). Default 15000.
# Railway cold-starts can take 10-30s — 8000 is too low and causes silent hangs.
PROXY_TIMEOUT_MS=15000
# Number of retries for idempotent GET requests (availability, packages, etc).
PROXY_GET_RETRIES=2
# Overall request timeout for this service (ms).
REQUEST_TIMEOUT=30000

#  Rate limiting 
MESSAGE_RATE_LIMIT=5
MESSAGE_RATE_WINDOW_HOURS=1

#  Security 
# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Internal API key  gates access to /docs and root API endpoint.
# REQUIRED IN PRODUCTION. Generate with: openssl rand -hex 32
INTERNAL_API_KEY="generate-with-openssl-rand-hex-32"

#  Misc 
VOICEMAIL_MAX_LENGTH=120