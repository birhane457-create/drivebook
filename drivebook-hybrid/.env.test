# Test environment configuration
NODE_ENV="test"
DATABASE_URL="file:./test.db"
PORT=3001
TWILIO_ACCOUNT_SID="test_account_sid"
TWILIO_AUTH_TOKEN="test_auth_token"
TWILIO_PHONE_NUMBER="+61400000000"  # Replace with your real AU Twilio number
TWILIO_AUTH_TOKEN_FOR_VALIDATION="test_auth_token"
COPILOT_API_URL="http://localhost:4000"
COPILOT_API_KEY="test_key"
COPILOT_TIMEOUT_MS=5000
DRIVEBOOK_API_BASE_URL="http://localhost:3000"
DRIVEBOOK_API_KEY="test_key"
REQUEST_TIMEOUT=10000
AUTH_SECRET="test-secret-do-not-use-in-production"
ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3000"
LOG_LEVEL="error"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
SMS_ENABLED="false"
VOICEMAIL_STORAGE_BUCKET="test-bucket"
VOICEMAIL_RETENTION_DAYS=1
