# Local Development Environment Variables
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and safe for local development

# Database - Use your local PostgreSQL or development Supabase instance
DATABASE_URL="postgresql://postgres:password@localhost:5432/drivebook_dev?sslmode=disable"
DIRECT_URL="postgresql://postgres:password@localhost:5432/drivebook_dev?sslmode=disable"

# NextAuth - Generate a secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-dev-secret-here"

# For local testing, you can use these test credentials
# or create your own development accounts

# Email - Use Mailhog or similar for local testing
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Dev Team <dev@localhost>"
SMTP_FROM="dev@localhost"

# Stripe - Use test mode keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_local_test

# Leave other services empty or use test/sandbox credentials
