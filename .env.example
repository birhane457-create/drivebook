# Database Configuration
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Supabase Configuration (if using Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_publishable_key

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_with: openssl rand -base64 32"

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Google Calendar OAuth2
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/callback"

# Email Configuration (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="your_email@example.com"
SMTP_PASS="your_email_password"
EMAIL_FROM="Your Platform <noreply@example.com>"
SMTP_FROM="noreply@example.com"

# Platform Settings
PLATFORM_NAME="Driving Instructor Platform"
ADMIN_EMAIL="admin@example.com"
ADMIN_REPORT_EMAIL="admin@example.com"

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+61400000000"

# VAPI (Voice AI) Configuration
VAPI_WEBHOOK_SECRET="your_vapi_webhook_secret"
VAPI_API_KEY="your_vapi_api_key"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe Payment Configuration (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Subscription Price IDs
STRIPE_BASIC_MONTHLY_PRICE_ID=price_basic_monthly
STRIPE_BASIC_ANNUAL_PRICE_ID=price_basic_annual
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual
STRIPE_STUDIO_MONTHLY_PRICE_ID=price_studio_monthly
STRIPE_STUDIO_ANNUAL_PRICE_ID=price_studio_annual
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_business_monthly
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_business_annual

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_redis_token"
KV_REST_API_TOKEN="your_kv_token"
KV_REST_API_URL="https://your-redis.upstash.io"

# Platform Commission Settings
PLATFORM_COMMISSION_RATE=12.0
NEW_STUDENT_BONUS_RATE=8.0

# Subscription Tier Pricing & Commission Rates
OPENAI_API_KEY=sk-proj-your_openai_api_key

# BASIC TIER
BASIC_MONTHLY_PRICE=29
BASIC_ANNUAL_PRICE=290
BASIC_COMMISSION_RATE=15
BASIC_NEW_STUDENT_BONUS=8
BASIC_TRIAL_DAYS=14

# PRO TIER
PRO_MONTHLY_PRICE=79
PRO_ANNUAL_PRICE=790
PRO_COMMISSION_RATE=12
PRO_NEW_STUDENT_BONUS=10
PRO_TRIAL_DAYS=14

# BUSINESS TIER
BUSINESS_MONTHLY_PRICE=199
BUSINESS_ANNUAL_PRICE=1990
BUSINESS_COMMISSION_RATE=10
BUSINESS_NEW_STUDENT_BONUS=12
BUSINESS_TRIAL_DAYS=30

# Platform Fees
PLATFORM_TRANSACTION_FEE=0
PLATFORM_FIXED_FEE=0

# ABR (Australian Business Register)
ABR_GUID=your_abr_guid

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_KEY=your_random_bypass_key

# Public Configuration
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_VOICE_PHONE_NUMBER="+61400000000"

# Vercel API (for custom domains)
VERCEL_API_TOKEN=your_vercel_token
VERCEL_PROJECT_ID=your_project_id
VERCEL_TEAM_ID=

# Optional: Resend (alternative email service)
# RESEND_API_KEY="your_resend_api_key"
