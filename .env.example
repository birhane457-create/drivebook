# .env.example
# Environment Configuration Template for DriveBook Platform
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials!

# DATABASE
DATABASE_URL=postgresql://user:password@host:5432/database
DIRECT_URL=postgresql://user:password@direct-host:5432/database

# SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# NEXTAUTH
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# GOOGLE SERVICES
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# EMAIL SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=your-email@gmail.com
SMTP_FROM=your-email@gmail.com

# TWILIO SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# VAPI Voice AI
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret
VAPI_API_KEY=your-vapi-api-key

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# STRIPE PAYMENT
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_BASIC_MONTHLY_PRICE_ID=price_id_here
STRIPE_BASIC_ANNUAL_PRICE_ID=price_id_here
STRIPE_PRO_MONTHLY_PRICE_ID=price_id_here
STRIPE_PRO_ANNUAL_PRICE_ID=price_id_here
STRIPE_STUDIO_MONTHLY_PRICE_ID=price_id_here
STRIPE_STUDIO_ANNUAL_PRICE_ID=price_id_here
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_id_here
STRIPE_BUSINESS_ANNUAL_PRICE_ID=price_id_here

# UPSTASH REDIS
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token
KV_REST_API_TOKEN=your-kv-token
KV_REST_API_URL=https://your-redis.upstash.io

# OPENAI
OPENAI_API_KEY=sk-proj-your-openai-key

# PLATFORM SETTINGS
PLATFORM_NAME=Driving Instructor Platform
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_REPORT_EMAIL=admin@yourdomain.com
PLATFORM_COMMISSION_RATE=12.0
NEW_STUDENT_BONUS_RATE=8.0

# PRICING
BASIC_MONTHLY_PRICE=29
BASIC_ANNUAL_PRICE=290
BASIC_COMMISSION_RATE=15
BASIC_NEW_STUDENT_BONUS=8
BASIC_TRIAL_DAYS=14
PRO_MONTHLY_PRICE=79
PRO_ANNUAL_PRICE=790
PRO_COMMISSION_RATE=12
PRO_NEW_STUDENT_BONUS=10
PRO_TRIAL_DAYS=14
BUSINESS_MONTHLY_PRICE=199
BUSINESS_ANNUAL_PRICE=1990
BUSINESS_COMMISSION_RATE=10
BUSINESS_NEW_STUDENT_BONUS=12
BUSINESS_TRIAL_DAYS=30
PLATFORM_TRANSACTION_FEE=0
PLATFORM_FIXED_FEE=0

# OTHER
ABR_GUID=your-abr-guid
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_KEY=your-bypass-key
NEXT_PUBLIC_ROOT_DOMAIN=yourdomain.com
NEXT_PUBLIC_VOICE_PHONE_NUMBER=+1234567890
VERCEL_API_TOKEN=your-vercel-token
VERCEL_PROJECT_ID=your-project-id
VERCEL_TEAM_ID=

# SECURITY / FEATURE FLAGS
# INT-M-PKG-01 CONTAINMENT: Mobile package purchase is disabled by default
# pending implementation of secure package catalog + payment flow.
# DO NOT enable this until the replacement architecture is complete.
# See: docs/audit/phase2/INT-M-PKG-01-DISCOVERY.md
ENABLE_MOBILE_PACKAGE_PURCHASE=false
