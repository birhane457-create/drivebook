# ============================================================
# DriveBook — Environment Variables Reference
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Generate NEXTAUTH_SECRET with:
#   openssl rand -base64 32
# ============================================================

# ── Database (PostgreSQL / Supabase) ──────────────────────────────────────────
# Connection-pooled URL (used at runtime via PgBouncer)
DATABASE_URL="postgresql://postgres.YOURPROJECT:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Direct URL (used by Prisma migrations only)
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOURPROJECT.supabase.co:5432/postgres?sslmode=require"

# Supabase JS client (optional — only needed for realtime/storage features)
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_YOUR_KEY

# ── NextAuth ──────────────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -base64 32
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ── Google Maps ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ── Google Calendar OAuth2 ────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"
GOOGLE_REDIRECT_URI="https://yourdomain.com/api/calendar/callback"

# ── Email (Gmail SMTP or any SMTP provider) ───────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
# Gmail: use an App Password (not your login password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="your-email@gmail.com"
SMTP_FROM="your-email@gmail.com"

# ── Twilio (SMS) ──────────────────────────────────────────────────────────────
# Required for check-in/check-out SMS and booking notifications
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+61400000000"

# ── Cloudinary (Image/Document Upload) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── Stripe ────────────────────────────────────────────────────────────────────
# Test keys during development, live keys in production
# Dashboard: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"
STRIPE_SECRET_KEY="sk_test_your_secret_key"

# Webhook secret — get from: Stripe Dashboard → Webhooks → your endpoint → Signing secret
# Local testing: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Stripe Subscription Price IDs — create in Stripe Dashboard → Products
STRIPE_BASIC_MONTHLY_PRICE_ID="price_xxx"
STRIPE_BASIC_ANNUAL_PRICE_ID="price_xxx"
STRIPE_PRO_MONTHLY_PRICE_ID="price_xxx"
STRIPE_PRO_ANNUAL_PRICE_ID="price_xxx"
STRIPE_STUDIO_MONTHLY_PRICE_ID="price_xxx"
STRIPE_STUDIO_ANNUAL_PRICE_ID="price_xxx"
STRIPE_BUSINESS_MONTHLY_PRICE_ID="price_xxx"
STRIPE_BUSINESS_ANNUAL_PRICE_ID="price_xxx"

# ── Platform Config ───────────────────────────────────────────────────────────
PLATFORM_NAME="DriveBook"
# Default timezone for reminder messages and date formatting.
# DriveBook is WA-based — always set this to Australia/Perth.
# Fallback in code is also Australia/Perth, but explicit is better.
DEFAULT_TIMEZONE="Australia/Perth"
# Weekly payout batch size — max instructors processed per cron invocation.
# Increase as instructor numbers grow. Default 20 is safe for Vercel 60s timeout.
PAYOUT_BATCH_SIZE=20
PLATFORM_COMMISSION_RATE=12.0
NEW_STUDENT_BONUS_RATE=8.0
NEXT_PUBLIC_ROOT_DOMAIN="drivebook.com.au"

# Admin email — receives weekly reports, liquidity alerts, dispute notifications
ADMIN_EMAIL="admin@yourdomain.com"
# Optional: separate email for scheduled reports (defaults to ADMIN_EMAIL)
ADMIN_REPORT_EMAIL="reports@yourdomain.com"

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
# Used by POST /api/admin/register to create the first admin account.
# Remove or leave blank after first admin is created.
ADMIN_BOOTSTRAP_KEY="generate-a-strong-random-key"

# ── Voice Service ─────────────────────────────────────────────────────────────
# API key used by the drivebook-hybrid voice service to authenticate requests.
# REQUIRED in production — must match the key configured in your voice service.
# Generate with: openssl rand -hex 32
VOICE_SERVICE_API_KEY="generate-with-openssl-rand-hex-32"

# Phone number for the AI voice receptionist — shown in homepage CTA and AI showcase.
# Format: Australian number e.g. +61400000000
# If not set, the "Or Call" CTA is hidden on the homepage.
NEXT_PUBLIC_VOICE_PHONE_NUMBER="+61400000000"

# ── Upstash Redis (Rate Limiting) ─────────────────────────────────────────────
# Free tier sufficient for most deployments.
# Create at: https://console.upstash.com
# Without this, rate limiting falls back to in-memory (not safe for multi-instance).
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ── ABR (Australian Business Register) ───────────────────────────────────────
# Free GUID for ABN verification API.
# Register at: https://abr.business.gov.au/Tools/WebServices
ABR_GUID="your-abr-guid"

# ── Vercel (Custom Domains — Studio tier) ────────────────────────────────────
# Only needed if you support instructor custom domains.
# Token: https://vercel.com/account/tokens
# Project ID: Vercel Dashboard → your project → Settings → General
VERCEL_API_TOKEN="your-vercel-api-token"
VERCEL_PROJECT_ID="your-vercel-project-id"
# Team ID: only if project is under a Vercel team (leave blank for personal)
VERCEL_TEAM_ID=""

# ── Maintenance Mode ──────────────────────────────────────────────────────────
MAINTENANCE_MODE=false
# Bypass key for maintenance mode — append ?bypass=KEY to any URL.
# Leave blank to disable bypass entirely.
MAINTENANCE_BYPASS_KEY="generate-a-strong-random-key"

# ── AI Admin Copilot ──────────────────────────────────────────────────────────
# Add ONE key to enable AI-generated briefs and the Operations Copilot chat.
# Without a key, the AI features show a setup prompt instead of failing.
#
# OpenAI (gpt-4o-mini) — ~$0.0001 per brief, ~$0.001 per chat query
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-key"
#
# Anthropic (claude-3-haiku) — fallback if OpenAI is not set
# Get key at: https://console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-your-anthropic-key"

# Microsoft Copilot Studio chat widget (optional)
# Direct Line token for the embedded CopilotChatWidget component.
# Leave blank to hide the widget — the admin copilot page still works without it.
# Get from: Copilot Studio → your bot → Channels → Direct Line
NEXT_PUBLIC_COPILOT_DIRECT_LINE_TOKEN=""

# ── Subscription Tier Pricing & Commission Rates ──────────────────────────────
BASIC_MONTHLY_PRICE=29
BASIC_ANNUAL_PRICE=290
BASIC_COMMISSION_RATE=15
BASIC_NEW_STUDENT_BONUS=8
BASIC_TRIAL_DAYS=14

PRO_MONTHLY_PRICE=79
PRO_ANNUAL_PRICE=790
PRO_COMMISSION_RATE=12
PRO_NEW_STUDENT_BONUS=10
PRO_TRIAL_DAYS=14

BUSINESS_MONTHLY_PRICE=199
BUSINESS_ANNUAL_PRICE=1990
BUSINESS_COMMISSION_RATE=10
BUSINESS_NEW_STUDENT_BONUS=12
BUSINESS_TRIAL_DAYS=30

PLATFORM_TRANSACTION_FEE=0
PLATFORM_FIXED_FEE=0

# Studio tier pricing (same pattern as other tiers)
STUDIO_MONTHLY_PRICE=129
STUDIO_ANNUAL_PRICE=1290
STUDIO_COMMISSION_RATE=11
STUDIO_NEW_STUDENT_BONUS=11
STUDIO_TRIAL_DAYS=14

# Owner/admin alerts
OWNER_EMAIL=owner@yourdomain.com
OWNER_PHONE=+61400000000

# Support contact — shown to callers by the AI receptionist on escalation.
# When these change, update VAPI_SYSTEM_PROMPT.md and re-upload to VAPI.
SUPPORT_PHONE=0488000000
SUPPORT_EMAIL=support@drivebook.com.au

# Alert webhook (e.g. Slack or PagerDuty) — leave blank to disable
ALERT_WEBHOOK_URL=

# Server-side Google Maps API key (geocoding/distance matrix — different from public key)
GOOGLE_MAPS_SERVER_API_KEY=

# OTP verification secret (used to hash/verify one-time passwords)
OTP_HASH_SECRET=

# Firebase (required for mobile push notifications via FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
