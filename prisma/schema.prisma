// QUOTE SYSTEM
// Supports the request â†’ quote â†’ accept â†’ pay booking flow.
// Used by SaaS businesses where the provider quotes before committing
// (plumber, electrician, cleaner, landscaper, etc.).
// Not used by marketplace/appointment businesses (driving school).
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

/// A quote issued by a provider in response to a customer's job request.
/// One Quote per Booking â€” a provider may revise by setting status=REVISED
/// and creating a new Quote on the same Booking.
///
/// Lifecycle:
///   Booking(REQUEST_PENDING)
///     â†’ provider calls submitQuote()  â†’ Quote(PENDING) + Booking(QUOTE_SENT)
///     â†’ customer calls acceptQuote()  â†’ Quote(ACCEPTED) + Booking(QUOTE_ACCEPTED)
///       â†’ SaaS:        Stripe Checkout created â†’ Booking(PENDING_PAYMENT)
///                       â†’ payment succeeds     â†’ Booking(CONFIRMED) + Quote.stripeSessionId
///       â†’ marketplace: wallet deduct           â†’ Booking(CONFIRMED) immediately
///     â†’ customer calls declineQuote() â†’ Quote(DECLINED) + Booking(QUOTE_DECLINED)
///     â†’ validUntil passes (cron)      â†’ Quote(EXPIRED)  + Booking(QUOTE_EXPIRED)
model Quote {
  id String @id @default(cuid())

  /// The Booking this quote is for. One active quote per booking.
  bookingId String

  /// Who issued the quote
  providerId String

  /// Who the quote is for
  customerId String

  /// Total quoted amount (AUD)
  amount Decimal @db.Decimal(12, 2)

  /// Human-readable summary sent to customer
  description String @db.Text

  /// Structured line items â€” array of { label: string, amount: number }
  lineItems Json @default("[]")

  /// When this quote expires if not accepted (provider sets this)
  validUntil DateTime

  /// Quote workflow status
  /// PENDING    â€” issued, waiting for customer response
  /// ACCEPTED   â€” customer accepted, booking moves to payment/confirmed
  /// DECLINED   â€” customer declined
  /// EXPIRED    â€” passed validUntil without response
  /// REVISED    â€” superseded by a newer quote on the same booking
  /// CANCELLED  â€” booking was cancelled before customer responded
  status String @default("PENDING")

  acceptedAt    DateTime?
  declinedAt    DateTime?
  declineReason String?

  /// Stripe Checkout Session ID â€” set when customer clicks "Pay Now" after accepting
  stripeSessionId       String? @unique
  /// Stripe PaymentIntent ID â€” set after checkout completes
  stripePaymentIntentId String?
  /// Checkout attempt generation — incremented atomically each time a session expires
  /// and a new one is needed. Forms the Stripe idempotency key: scs-{quoteId}-{gen}.
  /// Only advances via advanceCheckoutGeneration() which CAS-guards on
  /// (stripeSessionId, checkoutGeneration) to prevent concurrent double-advance.
  checkoutGeneration    Int     @default(1)

  /// Optional deposit (e.g. 30% upfront, remainder on completion)
  depositPercent Decimal? @db.Decimal(5, 2)
  depositAmount  Decimal? @db.Decimal(12, 2)
  depositPaid    Boolean  @default(false)

  /// Notes visible to customer
  customerNotes String? @db.Text
  /// Internal notes for the provider only
  internalNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([bookingId])
  @@index([providerId, status])
  @@index([customerId, status])
  @@index([status, validUntil])
}

