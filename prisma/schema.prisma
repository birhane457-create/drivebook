generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String?
  name             String?
  role             String    @default("CLIENT")
  instructorId     String?
  resetToken       String?
  resetTokenExpiry DateTime?
  termsAcceptedAt  DateTime?
  termsVersion     String?
  ageDeclaration   Boolean   @default(false)
  // Email verification
  emailVerified        Boolean   @default(false)
  emailVerifiedAt      DateTime?
  verificationToken    String?
  verificationTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clients     Client[]
  wallet      ClientWallet?
  instructor  Instructor?
  staffMember StaffMember?
}

model Client {
  id                    String     @id @default(cuid())
  userId                String?
  user                  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  instructorId          String
  instructor            Instructor @relation(fields: [instructorId], references: [id])
  name                  String
  email                 String
  phone                 String
  preferredInstructorId String?
  defaultPickupAddress  String?
  defaultPickupLat      Float?
  defaultPickupLng      Float?
  notes                 String?
  bookings              Booking[]
  pdaTestBookings       PDATestBooking[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model Instructor {
  id                   String  @id @default(cuid())
  userId               String? @unique
  user                 User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                 String
  phone                String
  hourlyRate           Float
  serviceAreas         String?
  copilotAgentEndpoint String?
  bio                  String?
  carMake              String?
  carModel             String?
  carYear              String?
  vehicleTypes         String?
  languages            String?
  baseAddress          String?
  baseAddressLat       Float?   // alias: baseLatitude
  baseAddressLng       Float?   // alias: baseLongitude
  baseLatitude         Float?
  baseLongitude        Float?
  serviceRadiusKm      Float?
  isActive             Boolean @default(true)
  isVerified           Boolean @default(false)
  isFeatured           Boolean @default(false)
  averageRating        Float?
  totalReviews         Int     @default(0)

  subscriptionTier          String    @default("BASIC")
  subscriptionStatus        String    @default("TRIAL")
  trialEndsAt               DateTime?
  customSlug                String?   // PRO+: slug.drivebook.com.au
  customDomain              String?   // Studio+: full custom domain (e.g. bookings.yourdomain.com.au)
  domainVerified            Boolean   @default(false)
  domainVerifiedAt          DateTime?
  brandedBookingPage        Boolean   @default(false)
  brandLogo                 String?
  brandColorPrimary         String?
  brandColorSecondary       String?
  showBrandingOnBookingPage Boolean   @default(false)
  maxInstructors            Int       @default(1)
  stripeCustomerId          String?
  stripeAccountId           String?

  licenseNumber          String?
  insuranceNumber        String?
  licenseImageFront      String?
  licenseImageBack       String?
  insurancePolicyDoc     String?
  policeCheckDoc         String?
  wwcCheckDoc            String?
  photoIdDoc             String?
  certificationDoc       String?
  vehicleRegistrationDoc String?
  profileImage           String?
  carImage               String?
  documentsVerified      Boolean   @default(false)
  documentsVerifiedAt    DateTime?
  licenseExpiry          DateTime?
  insuranceExpiry        DateTime?
  policeCheckExpiry      DateTime?
  wwcCheckExpiry         DateTime?
  approvalStatus         String    @default("PENDING")

  workingHours         Json?
  policyExceptionCount Int     @default(0)
  allowedDurations     Json?
  bookingBufferMinutes Int?
  enableTravelTime     Boolean @default(false)
  travelTimeMinutes    Int?
  // legacy instructor-defined packages removed: lessonPackages Json? (see PRICING.md)
  // FIX #14: Self-service booking pause toggle.
  // Instructors can pause new bookings without contacting admin or letting
  // their subscription lapse. Defaults to true (accepting bookings).
  acceptingBookings    Boolean @default(true)

  payoutMethod       String    @default("stripe_connect")
  payoutHold         Boolean   @default(false)   // true when a chargeback is open Ã¢â‚¬â€ blocks buildPayout
  payoutHoldReason   String?                     // set by handleDisputeOpened, cleared on win/resolution
  // Stripe Connect onboarding state Ã¢â‚¬â€ populated by account.updated webhook
  chargesEnabled     Boolean   @default(false)   // true when instructor can accept charges (onboarding complete)
  payoutsEnabled     Boolean   @default(false)   // true when instructor can receive payouts (bank linked)
  bankBsb            String?
  bankAccount        String?
  bankAccountName    String?
  abn                String?
  abnVerified        Boolean   @default(false)
  abnStatus          String?
  abnEntityName      String?
  abnVerifiedAt      DateTime?
  abnVerifiedBy      String?
  gstRegistered      Boolean   @default(false)
  withholdingTaxRate Float     @default(47)

  syncGoogleCalendar Boolean   @default(false)
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  googleCalendarId   String?
  calendarBufferMode String?

  whatsapp        String?
  instagram       String?
  facebook        String?
  yearsExperience Int?

  // PDA / Driving Test Package ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â instructor-controlled
  offersTestPackage    Boolean  @default(false)
  testPackagePrice     Float?
  testPackageDuration  Int?     // minutes
  testPackageIncludes  Json?    // string[]

  bookings      Booking[]
  clients       Client[]
  subscriptions Subscription[]
  expenses      InstructorExpense[]
  slotReservations SlotReservation[]
  pdaConfigs    PDATestConfig[]
  pdaBookings   PDATestBooking[]
}

model InstructorExpense {
  id           String     @id @default(cuid())
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  instructorId String
  date         DateTime
  category     String     // FUEL_VEHICLE | INSURANCE | TRAINING | EQUIPMENT | SUBSCRIPTION | OTHER
  description  String
  amount       Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Slot Reservation - temporary hold on lesson slots during booking
// Reserves a slot for 10 minutes while user completes payment
// Prevents double-booking by ensuring only one session can reserve each time slot
// Auto-deleted by cron when expiry time is reached
model SlotReservation {
  id            String   @id @default(cuid())
  instructorId  String
  instructor    Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  
  sessionId     String                       // Browser session ID - uniquely identifies the reservation holder
  startTime     DateTime                     // When the lesson would start (ISO format)
  endTime       DateTime                     // When the lesson would end — enables proper overlap detection
  expiresAt     DateTime                     // When reservation expires (10 mins after creation)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([instructorId, expiresAt])        // For efficient cleanup cron queries
  @@index([sessionId])                       // For session-based lookups
}

// Scheduled commission rate changes ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â admin sets a future effective date
// Cron applies the change on effectiveDate and notifies all instructors


model PlatformRateChange {
  id              String    @id @default(cuid())
  tier            String    // BASIC | PRO | STUDIO | BUSINESS | ALL
  field           String    // basicCommissionRate | proCommissionRate | businessCommissionRate
  currentRate     Float
  newRate         Float
  effectiveDate   DateTime
  reason          String    // shown to instructors in the notification
  status          String    @default("PENDING") // PENDING | APPLIED | CANCELLED
  notifiedAt      DateTime?
  appliedAt       DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Booking {
  id                    String     @id @default(cuid())
  instructor            Instructor @relation(fields: [instructorId], references: [id])
  instructorId          String
  client                Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId              String?
  clientName            String?
  clientPhone           String?
  bookingType           String?
  status                String     @default("PENDING")
  startTime             DateTime?
  endTime               DateTime?
  duration              Float?
  price                 Float      @default(0)
  platformFee           Float      @default(0)
  instructorPayout      Float      @default(0)
  commissionRate        Float      @default(0)
  isPaid                Boolean    @default(false)
  paidAt                DateTime?
  paymentCaptured       Boolean    @default(false)
  paymentCapturedAt     DateTime?
  paymentIntentId       String?
  paymentToken          String?    // cryptographically random token for secure payment link ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â required to access payment page
  pickupAddress         String?
  pickupLatitude        Float?
  pickupLongitude       Float?
  dropoffAddress        String?
  dropoffLatitude       Float?
  dropoffLongitude      Float?
  notes                 String?
  isFirstBooking        Boolean    @default(false)
  isPackageBooking      Boolean    @default(false)
  parentBookingId       String?
  packageHours          Float?
  packageHoursUsed      Float      @default(0)
  packageHoursRemaining Float?
  packageTotalPaid      Float?
  packageExpiryDate     DateTime?
  packageStatus         String?
  lockedHourlyRate      Float?     // Rate at time of package purchase ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â never changes
  lockedDiscountPct     Float?     // Discount % at time of package purchase ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â never changes
  createdBy             String?
  originalStartTime     DateTime?
  isNonRefundable       Boolean    @default(false)
  rescheduledFrom       Json?
  rescheduleCount       Int        @default(0)
  deletedAt             DateTime?
  deletedBy             String?
  cancelledAt           DateTime?  // when the booking was cancelled
  noShowParty           String?
  googleCalendarEventId String?
  lessonFeedback        Int[]      @default([])
  instructorNotes       String?
  feedbackGivenAt       DateTime?
  studentStrengths      Int[]      @default([])
  focusAreas            Int[]      @default([])
  performanceScore      Int?
  whiteboardSketchUrl   String?    // Cloudinary URL of the lesson sketch drawn by instructor
  clientRating          Int?
  clientReview          String?
  reviewGivenAt         DateTime?
  // Check-in / Check-out tracking
  checkInTime           DateTime?
  checkInLocation       String?
  checkInBy             String?    // 'instructor' | 'client'
  checkInPhoto          String?
  checkOutTime          DateTime?
  checkOutLocation      String?
  checkOutBy            String?    // 'instructor' | 'client'
  checkOutPhoto         String?
  actualDuration        Int?       // minutes
  smsCheckOutSent       Boolean    @default(false)
  source                String     @default("platform") // 'platform' | 'offline'
  offlinePaymentMethod  String?    // 'cash' | 'bank_transfer' | 'other'
  offlineAmountPaid     Float?     // instructor's record only ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â not platform revenue
  clientEmail           String?    // stored for offline bookings ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â used for email reminders
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  transactions Transaction[]
}

model Transaction {
  id                    String   @id @default(cuid())
  bookingId             String?
  booking               Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  instructorId          String
  type                  String
  amount                Float
  platformFee           Float    @default(0)
  instructorPayout      Float    @default(0)
  commissionRate        Float    @default(0)
  status                String   @default("PENDING")
  description           String?
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeTransferId      String?
  taxWithheld           Float    @default(0)
  gstAmount             Float    @default(0)
  metadata              Json?
  resolutionGroupId     String?
  resolutionStatus      String?
  processedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  payoutTransactions PayoutTransaction[]
}

model ClientWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String       @id @default(cuid())
  walletId    String
  wallet      ClientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        String
  description String?
  status      String       @default("PENDING")
  metadata    Json?        // optional: stripe fee tracking, admin notes, etc.
  bookingId   String?      // set when this transaction is tied to a specific booking (e.g. reschedule debit/credit)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Message {
  id           String   @id @default(cuid())
  callerNumber String
  callerName   String?
  message      String
  timestamp    DateTime @default(now())
  status       String
}

model Subscription {
  id                   String     @id @default(cuid())
  instructorId         String
  instructor           Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  tier                 String
  status               String     @default("ACTIVE")
  billingCycle         String     @default("monthly")
  monthlyAmount        Float
  stripeSubscriptionId String?
  stripeCustomerId     String?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean    @default(false)
  trialEndsAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  actorId      String
  actorRole    String
  targetType   String
  targetId     String
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())
}

model Payout {
  id               String    @id @default(cuid())
  instructorId     String
  status           String    @default("PENDING")
  grossAmount      Float
  taxWithheld      Float     @default(0)
  gstAmount        Float     @default(0)
  netAmount        Float
  payoutMethod     String
  stripeAccountId  String?
  stripeTransferId String?
  bankReference    String?
  sentAt           DateTime?
  sentBy           String?
  confirmedAt      DateTime?
  confirmedBy      String?
  idempotencyKey   String    @unique
  failureReason    String?
  holdReason       String?
  retryCount       Int       @default(0)
  approvedBy       String?
  approvedAt       DateTime?
  paidAt           DateTime?
  payoutRef        String    @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  transactions PayoutTransaction[]
}

model PayoutTransaction {
  id            String      @id @default(cuid())
  payoutId      String
  payout        Payout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model PlatformLedger {
  id               String   @id @default(cuid())
  key              String   @unique @default("default")
  totalCollected   Float    @default(0)
  totalReserved    Float    @default(0)
  totalPaidOut     Float    @default(0)
  totalRefunded    Float    @default(0)
  totalTaxWithheld Float    @default(0)
  updatedAt        DateTime @updatedAt
}

model LedgerEntry {
  id            String   @id @default(cuid())
  type          String
  amount        Float
  currency      String   @default("AUD")
  referenceId   String
  referenceType String
  instructorId  String?
  description   String?
  metadata      Json?
  createdAt     DateTime @default(now())
}

model WebhookEvent {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  eventType      String
  stripeEventId  String
  metadata       Json?
  processedAt    DateTime @default(now())
}

model PlatformSettings {
  id                          String   @id @default(cuid())
  key                         String   @unique @default("default")
  basicCommissionRate         Float    @default(15)
  proCommissionRate           Float    @default(12)
  businessCommissionRate      Float    @default(10)
  basicNewStudentBonus        Float    @default(8)
  proNewStudentBonus          Float    @default(10)
  businessNewStudentBonus     Float    @default(12)
  platformFeePercentage       Float    @default(3.6)
  package6Discount            Float    @default(5)
  package10Discount           Float    @default(10)
  package15Discount           Float    @default(12)
  discountPaidBy              String   @default("shared")
  drivingTestPackagePrice     Float    @default(225)
  cancellationFee             Float    @default(0)
  lateCancellationWindowHours Float    @default(24)
  noShowPenaltyAmount         Float    @default(0)
  walletTopUpMin              Float    @default(10)
  walletTopUpMax              Float    @default(500)
  gstEnabled                  Boolean  @default(true)
  gstRate                     Float    @default(10)
  withholdingTaxRate          Float    @default(47)
  peakSurchargeEnabled        Boolean  @default(false)
  peakSurchargePercent        Float    @default(0)
