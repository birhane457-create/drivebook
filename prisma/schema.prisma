// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  email            String    @unique
  password         String?
  name             String?
  role             String    @default("CLIENT")
  instructorId     String?   @db.ObjectId
  resetToken       String?
  resetTokenExpiry DateTime?
  // Terms acceptance tracking
  termsAcceptedAt  DateTime?
  termsVersion     String?   // e.g. "1.0" — matches Terms page version
  ageDeclaration   Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clients    Client[]
  wallet     ClientWallet?
  instructor Instructor?
}

// Client model for booking clients
model Client {
  id                    String     @id @default(auto()) @map("_id") @db.ObjectId
  userId                String?    @db.ObjectId
  user                  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  instructorId          String     @db.ObjectId
  instructor            Instructor @relation(fields: [instructorId], references: [id])
  name                  String
  email                 String
  phone                 String
  preferredInstructorId String?    @db.ObjectId
  defaultPickupAddress  String?
  defaultPickupLat      Float?
  defaultPickupLng      Float?
  notes                 String?
  bookings              Booking[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
}

model Instructor {
  id                   String  @id @default(auto()) @map("_id") @db.ObjectId
  userId               String? @unique @db.ObjectId
  user                 User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                 String
  phone                String
  hourlyRate           Float
  serviceAreas         String?
  copilotAgentEndpoint String?

  // Profile & vehicle info
  bio             String?
  carMake         String?
  carModel        String?
  carYear         String?
  vehicleTypes    String?
  languages       String?
  baseAddress     String?
  serviceRadiusKm Float?
  isActive        Boolean @default(true)
  isVerified      Boolean @default(false)
  isFeatured      Boolean @default(false)
  averageRating   Float?
  totalReviews    Int     @default(0)

  // Subscription fields
  subscriptionTier   String    @default("BASIC")
  subscriptionStatus String    @default("TRIAL")
  trialEndsAt        DateTime?
  customDomain            String?
  brandedBookingPage      Boolean @default(false)
  brandLogo               String?
  brandColorPrimary       String?
  brandColorSecondary     String?
  showBrandingOnBookingPage Boolean @default(false)
  maxInstructors          Int     @default(1)
  stripeCustomerId   String?
  stripeAccountId    String?

  // Document fields
  licenseNumber          String?
  insuranceNumber        String?
  licenseImageFront      String?
  licenseImageBack       String?
  insurancePolicyDoc     String?
  policeCheckDoc         String?
  wwcCheckDoc            String?
  photoIdDoc             String?
  certificationDoc       String?
  vehicleRegistrationDoc String?
  profileImage           String?
  carImage               String?
  documentsVerified      Boolean   @default(false)
  documentsVerifiedAt    DateTime?
  licenseExpiry          DateTime?
  insuranceExpiry        DateTime?
  policeCheckExpiry      DateTime?
  wwcCheckExpiry         DateTime?
  approvalStatus         String    @default("PENDING")

  // Booking configuration fields
  workingHours         Json?
  policyExceptionCount Int     @default(0) // increments when instructor reschedules inside 24h window
  allowedDurations     Json?
  bookingBufferMinutes Int?
  enableTravelTime     Boolean @default(false)
  travelTimeMinutes    Int?
  lessonPackages       Json?

  // Payout / tax details
  payoutMethod       String    @default("stripe_connect") // stripe_connect | bank_transfer | manual
  bankBsb            String?   // BSB for bank transfer payouts (AU format: XXX-XXX)
  bankAccount        String?   // Bank account number
  bankAccountName    String?   // Account holder name
  abn                String?   // Australian Business Number (11 digits)
  abnVerified        Boolean   @default(false) // true after ABR API confirms active + name match
  abnStatus          String?   // ACTIVE | CANCELLED | REVIEW_REQUIRED (from ABR)
  abnEntityName      String?   // Entity name returned by ABR (for name-match audit)
  abnVerifiedAt      DateTime? // when verification was last confirmed
  abnVerifiedBy      String?   // admin userId or 'SYSTEM'
  // taxFileNumber   String?   // TFN — commented out: highly sensitive, not collected until legally required
  gstRegistered      Boolean   @default(false) // whether instructor is GST-registered
  withholdingTaxRate Float     @default(47)    // % withheld if no verified ABN (ATO default: 47%)

  // Google Calendar integration fields
  syncGoogleCalendar Boolean   @default(false)
  googleTokenExpiry  DateTime?
  calendarBufferMode String?

  // Public profile / social links
  whatsapp         String?
  instagram        String?
  facebook         String?
  yearsExperience  Int?

  bookings      Booking[]
  clients       Client[]
  subscriptions Subscription[]
}

model Booking {
  id                    String     @id @default(auto()) @map("_id") @db.ObjectId
  instructor            Instructor @relation(fields: [instructorId], references: [id])
  instructorId          String     @db.ObjectId
  client                Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId              String?    @db.ObjectId
  clientName            String?
  clientPhone           String?
  bookingType           String?
  status                String     @default("PENDING")
  startTime             DateTime?
  endTime               DateTime?
  duration              Float?
  price                 Float      @default(0)
  platformFee           Float      @default(0)
  instructorPayout      Float      @default(0)
  commissionRate        Float      @default(0)
  isPaid                Boolean    @default(false)
  paidAt                DateTime?
  paymentCaptured       Boolean    @default(false)
  paymentCapturedAt     DateTime?
  paymentIntentId       String?
  pickupAddress         String?
  pickupLatitude        Float?
  pickupLongitude       Float?
  dropoffAddress        String?
  dropoffLatitude       Float?
  dropoffLongitude      Float?
  notes                 String?
  isFirstBooking        Boolean    @default(false)
  isPackageBooking      Boolean    @default(false)
  parentBookingId       String?    @db.ObjectId
  packageHours          Float?
  packageHoursUsed      Float      @default(0)
  packageHoursRemaining Float?
  packageTotalPaid      Float?     // Full Stripe charge for the package (used for wallet credit on payment)
  packageExpiryDate     DateTime?
  packageStatus         String?
  createdBy             String?
  originalStartTime     DateTime?
  isNonRefundable       Boolean    @default(false)
  rescheduledFrom       Json?
  rescheduleCount       Int        @default(0)
  deletedAt             DateTime? // soft delete timestamp
  deletedBy             String? // userId who deleted it
  // Google Calendar
  googleCalendarEventId String?   // used by calendar sync routes
  // Lesson feedback fields
  lessonFeedback        Int[]      @default([])
  instructorNotes       String?
  feedbackGivenAt       DateTime?
  studentStrengths      Int[]      @default([])
  focusAreas            Int[]      @default([])
  performanceScore      Int?
  // Client review fields
  clientRating          Int?       // 1-5 stars
  clientReview          String?
  reviewGivenAt         DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  transactions Transaction[]
}

model Transaction {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId             String?  @db.ObjectId
  booking               Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  instructorId          String   @db.ObjectId
  type                  String
  amount                Float
  platformFee           Float    @default(0)
  instructorPayout      Float    @default(0)
  commissionRate        Float    @default(0)
  status                String   @default("PENDING")
  description           String?
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeTransferId      String?  // Stripe transfer ID when payout is via Stripe Connect
  taxWithheld           Float    @default(0) // ATO withholding tax deducted from payout
  gstAmount             Float    @default(0) // GST component if instructor is GST-registered
  metadata              Json?
  // Split resolution tracking — links refund + approve_for_payout into one logical operation
  resolutionGroupId     String?  // shared ID across both legs of a split resolution
  resolutionStatus      String?  // PENDING | PARTIAL | COMPLETED | FAILED
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ClientWallet {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  walletId    String       @db.ObjectId
  wallet      ClientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        String
  description String?
  status      String       @default("PENDING")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Message {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  callerNumber String
  callerName   String?
  message      String
  timestamp    DateTime @default(now())
  status       String
}

model Subscription {
  id                   String     @id @default(auto()) @map("_id") @db.ObjectId
  instructorId         String     @db.ObjectId
  instructor           Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  tier                 String
  status               String     @default("ACTIVE")
  billingCycle         String     @default("monthly")
  monthlyAmount        Float
  stripeSubscriptionId String?
  stripeCustomerId     String?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean    @default(false)
  trialEndsAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  action       String // BOOKING_CREATED, BOOKING_CANCELLED, BOOKING_DELETED, BOOKING_RESCHEDULED, etc.
  actorId      String // userId who performed the action
  actorRole    String // CLIENT, INSTRUCTOR, ADMIN, SYSTEM
  targetType   String // BOOKING, TRANSACTION, WALLET, USER
  targetId     String // ID of the affected record
  ipAddress    String?
  userAgent    String?
  metadata     Json? // snapshot of data before change, reason, etc.
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())
}

// Payout — separate entity per instructor payout batch
// State machine:
//   Stripe Connect:  ELIGIBLE → PROCESSING → PAID
//   Bank/Manual:     ELIGIBLE → PROCESSING → PENDING_TRANSFER → SENT → PAID
//                                          ↘ FAILED
//                                          ↘ ON_HOLD
model Payout {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  instructorId      String    @db.ObjectId

  // State machine:
  // PENDING | ELIGIBLE | PROCESSING | PENDING_TRANSFER | SENT | PAID | FAILED | ON_HOLD
  // PENDING_TRANSFER = approved, awaiting admin to do manual bank transfer
  // SENT             = admin recorded bank reference, awaiting confirmation
  // PAID             = money confirmed moved (Stripe transfer OR admin confirmed)
  status            String    @default("PENDING")

  // Amounts (locked at build time — never mutated after creation)
  grossAmount       Float     // sum of instructorPayout across linked transactions
  taxWithheld       Float     @default(0)
  gstAmount         Float     @default(0)
  netAmount         Float     // grossAmount − taxWithheld

  // Payout method snapshot (at time of payout)
  payoutMethod      String    // stripe_connect | bank_transfer | manual
  stripeAccountId   String?
  stripeTransferId  String?   // set once Stripe transfer succeeds

  // Manual transfer evidence (bank_transfer / manual only)
  bankReference     String?   // BSB/account or bank transaction ref entered by admin
  sentAt            DateTime? // when admin clicked "Mark Sent"
  sentBy            String?   // admin userId who marked sent
  confirmedAt       DateTime? // when admin confirmed receipt (optional)
  confirmedBy       String?   // admin userId who confirmed

  // SHA-256 of sorted transaction IDs — collision-free, used as Stripe idempotency key
  idempotencyKey    String    @unique

  // Failure / hold tracking
  failureReason     String?
  holdReason        String?   // reason for ON_HOLD (e.g. "dispute", "admin hold")
  retryCount        Int       @default(0)

  // Admin who approved
  approvedBy        String?   // admin userId
  approvedAt        DateTime?
  paidAt            DateTime?

  // Human-readable reference
  payoutRef         String    @unique

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  transactions      PayoutTransaction[]
}

// Join table — which transactions are included in a payout
model PayoutTransaction {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  payoutId      String  @db.ObjectId
  payout        Payout  @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  transactionId String  @db.ObjectId
}

// Platform Ledger — singleton, updated atomically on every financial event.
// Provides real-time balance visibility and prevents overpayment.
// key = "default" (one record only)
model PlatformLedger {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  key              String   @unique @default("default")

  totalCollected   Float    @default(0) // sum of all captured booking payments (amount)
  totalReserved    Float    @default(0) // sum of instructorPayout on SETTLED transactions not yet paid out
  totalPaidOut     Float    @default(0) // sum of netAmount on PAID payouts
  totalRefunded    Float    @default(0) // sum of refunded amounts
  totalTaxWithheld Float    @default(0) // cumulative ATO withholding across all paid payouts

  // availableBalance = totalCollected − totalPaidOut − totalRefunded
  // Computed on read — not stored (avoids drift)

  updatedAt        DateTime @updatedAt
}

// Ledger of Truth — append-only financial event log.
// Every money movement creates one entry. Never updated after creation.
model LedgerEntry {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  type          String   // PAYMENT_COLLECTED | PAYOUT_PAID | REFUND_ISSUED | TAX_WITHHELD | ADJUSTMENT
  amount        Float    // positive = money in, negative = money out
  currency      String   @default("AUD")
  referenceId   String   // bookingId, payoutId, transactionId, etc.
  referenceType String   // BOOKING | PAYOUT | TRANSACTION | ADJUSTMENT
  instructorId  String?  @db.ObjectId
  description   String?
  metadata      Json?
  createdAt     DateTime @default(now())
}

model WebhookEvent {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  idempotencyKey String   @unique
  eventType      String
  stripeEventId  String
  metadata       Json?
  processedAt    DateTime @default(now())
}

// Singleton — only one record (key = "default")
model PlatformSettings {
  id                        String   @id @default(auto()) @map("_id") @db.ObjectId
  key                       String   @unique @default("default")

  // Commission rates per subscription tier (%)
  basicCommissionRate       Float    @default(15)
  proCommissionRate         Float    @default(12)
  businessCommissionRate    Float    @default(10)

  // New student bonus per tier (%)
  basicNewStudentBonus      Float    @default(8)
  proNewStudentBonus        Float    @default(10)
  businessNewStudentBonus   Float    @default(12)

  // Platform fee on top of commission (%)
  platformFeePercentage     Float    @default(3.6)

  // Package discounts (%)
  package6Discount          Float    @default(5)
  package10Discount         Float    @default(10)
  package15Discount         Float    @default(12)

  // Discount absorbed by
  discountPaidBy            String   @default("shared") // platform | shared | instructor

  // Driving test package
  drivingTestPackagePrice   Float    @default(225)

  // Cancellation / no-show
  cancellationFee           Float    @default(0)
  lateCancellationWindowHours Float  @default(24)
  noShowPenaltyAmount       Float    @default(0)

  // Wallet
  walletTopUpMin            Float    @default(10)
  walletTopUpMax            Float    @default(500)

  // GST
  gstEnabled                Boolean  @default(true)
  gstRate                   Float    @default(10)

  // Withholding tax (no TFN/ABN supplied)
  withholdingTaxRate        Float    @default(47) // ATO default: 47% if no verified ABN

  // Peak surcharge
  peakSurchargeEnabled      Boolean  @default(false)
  peakSurchargePercent      Float    @default(0)

  updatedAt                 DateTime @updatedAt
  updatedBy                 String?  // admin userId who last changed it
}


// Reconciliation report — one record per daily cron run.
// Detection only — never auto-fixes. Admin must act on flagged issues.
model ReconciliationReport {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  startedAt           DateTime @default(now())
  completedAt         DateTime?
  status              String   // RUNNING | SUCCESS | WARNING | FAILED
  windowStart         DateTime // start of the Stripe data window checked
  windowEnd           DateTime // end of the Stripe data window checked

  // Counts
  paymentsChecked     Int      @default(0)
  missingPayments     Int      @default(0) // Stripe payment_intent.succeeded with no LedgerEntry
  transfersChecked    Int      @default(0)
  missingTransfers    Int      @default(0) // PAID payout with stripeTransferId not found in Stripe
  stuckPayouts        Int      @default(0) // PROCESSING > 10 min

  // Full detail for admin drill-down
  metadata            Json?    // arrays of flagged IDs + descriptions

  createdAt           DateTime @default(now())
}
