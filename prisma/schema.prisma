model ReconciliationReport {
  id               String    @id @default(cuid())
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  status           String
  windowStart      DateTime
  windowEnd        DateTime
  paymentsChecked  Int       @default(0)
  missingPayments  Int       @default(0)
  transfersChecked Int       @default(0)
  missingTransfers Int       @default(0)
  stuckPayouts     Int       @default(0)
  metadata         Json?
  createdAt        DateTime  @default(now())
}

model AvailabilityException {
  id           String   @id @default(cuid())
  instructorId String
  label        String?  // e.g. "Cash lesson - John", "Holiday", "Personal"
  reason       String?  // internal reason code: 'google_calendar_event' | 'pda_test' | etc.
  exceptionDate DateTime
  startTime    String   // "HH:mm"
  endTime      String   // "HH:mm"
  allDay       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([instructorId, exceptionDate])
}

model LearningContent {
  id           String   @id @default(cuid())
  title        String
  description  String
  tipText      String
  videoUrl     String?
  thumbnailUrl String?
  category     String
  difficulty   String   @default("basic")
  pdaCodes     Int[]    @default([])
  durationSec  Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TestCentre {
  id                  String   @id @default(cuid())
  name                String   @unique
  address             String
  suburb              String
  state               String   @default("WA")
  region              String?
  lat                 Float?
  lng                 Float?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  pdaConfigs          PDAConfigTestCentre[]
  pdaBookings         PDATestBooking[]
}

model PDATestConfig {
  id                  String   @id @default(cuid())
  instructorId        String
  instructor          Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  name                String
  durationMinutes     Int       // e.g., 165 (2h45m standard test)
  price               Float     // instructor's price for this config
  discountPercent     Float?    // optional discount percentage
  includes            Json?     // { pickup: true, dropoff: true, debriefing: true }
  notes               String?   // internal notes
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  testCentres         PDAConfigTestCentre[]
  bookings            PDATestBooking[]

  @@index([instructorId])
  @@index([isActive])
}

// Join table for many-to-many relationship: PDATestConfig <-> TestCentre
model PDAConfigTestCentre {
  id              String   @id @default(cuid())
  pdaConfigId     String
  pdaConfig       PDATestConfig @relation(fields: [pdaConfigId], references: [id], onDelete: Cascade)
  testCentreId    String
  testCentre      TestCentre @relation(fields: [testCentreId], references: [id], onDelete: Cascade)
  
  @@unique([pdaConfigId, testCentreId])
  @@index([testCentreId])
}

model PDATestBooking {
  id                  String   @id @default(cuid())
  instructorId        String
  instructor          Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  clientId            String
  client              Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  configId            String
  config              PDATestConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  testCentreId        String
  testCentre          TestCentre @relation(fields: [testCentreId], references: [id])
  testDate            DateTime  // date and time of the test
  testTime            String    // HH:mm format for display
  price               Float     // final price after discounts
  discountPercent     Float?    // discount applied at booking time
  status              String    @default("PENDING") // PENDING | CONFIRMED | COMPLETED | CANCELLED
  result              String?   // PASS | FAIL | NO_SHOW (populated after test)
  parentBookingId     String?   // optional link to parent lesson package booking
  notes               String?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([instructorId, testDate])
  @@index([clientId])
  @@index([configId])
  @@index([testCentreId])
  @@index([status])
}

// Idempotency deduplication for booking creation.
// Stores the first successful response for each Idempotency-Key so retries
// (browser double-click, Twilio retry, network timeout, AI retry) return the
// same response without creating a duplicate booking.
// Keys are scoped per email to prevent cross-account collisions.
// Cleanup: keys older than 24 hours are purged by the cleanup cron.
model BookingIdempotencyKey {
  key         String   @id                  // raw Idempotency-Key header value
  email       String                        // account holder email ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â scope guard
  bookingId   String                        // booking created for this key
  response    Json                          // full response body to replay on retry
  createdAt   DateTime @default(now())

  @@index([createdAt])                      // for efficient cleanup cron query
  @@index([email])                          // for cross-account collision check
}

// Cron health tracking Ã¢â‚¬â€ each cron pings this table on completion.
// The health-check cron reads it and alerts if any job has not run recently.
model CronHealth {
  id          String    @id @default(cuid())
  jobName     String    @unique            // e.g. "cleanup-expired-bookings"
  lastRunAt   DateTime                     // when the job last completed successfully
  lastStatus  String    @default("OK")    // OK | FAILED
  lastError   String?                     // error message if FAILED
  runCount    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@index([jobName])
}

// Sprint A: Stripe dispute tracking
// Persists dispute state so we can freeze payouts, track outcomes, and
// recover losses via the ADJUSTMENT system already in payout-service.
model StripeDispute {
  id                  String    @id @default(cuid())
  stripeDisputeId     String    @unique          // dp_xxx from Stripe
  stripeChargeId      String                     // ch_xxx
  stripePaymentIntentId String?                  // pi_xxx Ã¢â‚¬â€ for booking lookup
  bookingId           String?                    // resolved from PI metadata
  instructorId        String?                    // resolved from booking
  amount              Float                      // disputed amount in AUD
  currency            String    @default("AUD")
  reason              String                     // fraud | duplicate | product_not_received | etc.
  status              String                     // warning_needs_response | needs_response | under_review | won | lost | charge_refunded
  payoutFrozen        Boolean   @default(false)  // true when we hold the instructor's next payout
  adjustmentCreated   Boolean   @default(false)  // true when ADJUSTMENT ledger entry written (lost disputes)
  resolvedAt          DateTime?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([bookingId])
  @@index([instructorId])
  @@index([stripePaymentIntentId])
}

// Staff member Ã¢â‚¬â€ platform operators who handle tasks, support, and governance.
// Linked 1:1 to a User account (role = STAFF | ADMIN | SUPER_ADMIN).
model StaffMember {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String
  email                  String   @unique
  department             String   // FINANCIAL | TECHNICAL | SUPPORT
  isActive               Boolean  @default(true)
  isSupervisor           Boolean  @default(false)

  // Workload tracking
  currentLoad            Int      @default(0)   // active tasks assigned
  maxCapacity            Int      @default(10)  // max concurrent tasks
  tasksCompleted         Int      @default(0)
  avgResolutionTimeHours Float?
  satisfactionScore      Float?
  skills                 Json?    // string[]

  // Permissions
  canApproveRefunds      Boolean  @default(false)
  canOverridePolicy      Boolean  @default(false)
  canAccessFinancials    Boolean  @default(false)
  maxRefundAmount        Float    @default(100)  // max refund without supervisor approval

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assignedTasks  Task[]      @relation("AssignedTasks")
  taskNotes      TaskNote[]

  @@index([department, isActive])
}

// Task Ã¢â‚¬â€ a work item for staff to action (support, financial, technical).
// Created automatically by fraud detection, dispute webhook, document expiry cron, etc.
model Task {
  id           String   @id @default(cuid())
  type         String   // REFUND_REQUEST | PAYMENT_DISPUTE | COMPLAINT | BOOKING_ISSUE | DOCUMENT_EXPIRY | CALENDAR_SYNC_ERROR | OTHER
  category     String   // FINANCIAL | TECHNICAL | SUPPORT
  priority     String   // URGENT | HIGH | NORMAL | LOW
  status       String   @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | WAITING_RESPONSE | ESCALATED | RESOLVED | CLOSED

  title        String
  description  String

  // Linked entities (optional Ã¢â‚¬â€ not all tasks relate to every entity)
  instructorId String?
  clientId     String?
  bookingId    String?
  userId       String?

  // Contact info (for external/guest contacts)
  contactName  String?
  contactEmail String?
  contactPhone String?

  // Assignment
  assignedToId String?
  assignedTo   StaffMember? @relation("AssignedTasks", fields: [assignedToId], references: [id])
  assignedAt   DateTime?
  autoAssigned Boolean      @default(false)
  dueDate      DateTime?

  // Financial
  financialAmount Float?
  financialImpact Json?
  requiresApproval Boolean @default(false)

  // SLA tracking
  firstResponseAt     DateTime?
  slaBreached         Boolean   @default(false)
  slaBreachReason     String?
  resolutionTimeHours Float?

  // Escalation
  escalatedAt      DateTime?
  escalatedTo      String?
  escalationReason String?
  escalationCount  Int       @default(0)
  autoEscalated    Boolean   @default(false)

  // Closure
  resolution          String?
  resolvedAt          DateTime?
  resolvedBy          String?
  closedAt            DateTime?
  closedBy            String?
  linkedEntityVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes TaskNote[]

  @@index([status, priority])
  @@index([instructorId])
  @@index([bookingId])
  @@index([assignedToId])
}

// TaskNote Ã¢â‚¬â€ internal notes and attachments on a task.
model TaskNote {
  id          String      @id @default(cuid())
  taskId      String
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staffId     String
  staff       StaffMember @relation(fields: [staffId], references: [id])
  note        String
  isInternal  Boolean     @default(true)
  attachments Json?       // string[] Ã¢â‚¬â€ URLs to uploaded attachments
  createdAt   DateTime    @default(now())

  @@index([taskId])
}

// FinancialLedger Ã¢â‚¬â€ double-entry accounting ledger (append-only).
// Every booking payment, payout, refund, and adjustment creates entries here.
// NEVER update or delete rows Ã¢â‚¬â€ immutable audit trail.
model FinancialLedger {
  id              String   @id @default(cuid())
  debitAccount    String   // e.g. PLATFORM_ESCROW:platform
  creditAccount   String   // e.g. CLIENT_WALLET:userId
  amount          Float
  description     String
  idempotencyKey  String   @unique  // prevents double-entries on retry
  bookingId       String?
  transactionId   String?
  payoutId        String?
  userId          String?
  instructorId    String?
  metadata        Json?
  createdBy       String   @default("SYSTEM")
  createdAt       DateTime @default(now())

  @@index([bookingId])
  @@index([instructorId])
  @@index([userId])
  @@index([createdAt])
}
