generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String        @id @default(cuid())
  email                   String        @unique
  password                String?
  name                    String?
  role                    String        @default("CLIENT")
  instructorId            String?
  resetToken              String?
  resetTokenExpiry        DateTime?
  termsAcceptedAt         DateTime?
  termsVersion            String?
  ageDeclaration          Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  emailVerified           Boolean       @default(false)
  emailVerifiedAt         DateTime?
  verificationToken       String?
  verificationTokenExpiry DateTime?
  clients                 Client[]
  wallet                  ClientWallet?
  instructor              Instructor?
  staffMember             StaffMember?
  deviceTokens            DeviceToken[]
  loginDevices            LoginDevice[]
}

model Client {
  id                    String           @id @default(cuid())
  userId                String?
  instructorId          String
  name                  String
  email                 String
  phone                 String
  preferredInstructorId String?
  defaultPickupAddress  String?
  defaultPickupLat      Float?
  defaultPickupLng      Float?
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  bookings              Booking[]
  instructor            Instructor       @relation(fields: [instructorId], references: [id])
  user                  User?            @relation(fields: [userId], references: [id])
  pdaTestBookings       PDATestBooking[]
}

model Instructor {
  id                        String              @id @default(cuid())
  userId                    String?             @unique
  name                      String
  phone                     String
  hourlyRate                Float
  serviceAreas              String?
  copilotAgentEndpoint      String?
  bio                       String?
  carMake                   String?
  carModel                  String?
  carYear                   String?
  vehicleTypes              String?
  languages                 String?
  baseAddress               String?
  serviceRadiusKm           Float?
  isActive                  Boolean             @default(true)
  isVerified                Boolean             @default(false)
  isFeatured                Boolean             @default(false)
  averageRating             Float?
  totalReviews              Int                 @default(0)
  subscriptionTier          String              @default("BASIC")
  subscriptionStatus        String              @default("TRIAL")
  trialEndsAt               DateTime?
  // Account type — INDIVIDUAL (default) or BUSINESS (school/multi-instructor).
  // Controls feature set and future white-label behaviour.
  accountType               String              @default("INDIVIDUAL")
  // Payment routing — PLATFORM (default, all tiers) or DIRECT (future BUSINESS feature).
  // DIRECT is not yet implemented. Payment routes guard against it with a 503.
  paymentMode               String              @default("PLATFORM")
  customDomain              String?
  brandedBookingPage        Boolean             @default(false)
  brandLogo                 String?
  brandColorPrimary         String?
  brandColorSecondary       String?
  showBrandingOnBookingPage Boolean             @default(false)
  maxInstructors            Int                 @default(1)
  stripeCustomerId          String?
  stripeAccountId           String?
  licenseNumber             String?
  insuranceNumber           String?
  licenseImageFront         String?
  licenseImageBack          String?
  insurancePolicyDoc        String?
  policeCheckDoc            String?
  wwcCheckDoc               String?
  photoIdDoc                String?
  certificationDoc          String?
  vehicleRegistrationDoc    String?
  profileImage              String?
  carImage                  String?
  documentsVerified         Boolean             @default(false)
  documentsVerifiedAt       DateTime?
  licenseExpiry             DateTime?
  insuranceExpiry           DateTime?
  policeCheckExpiry         DateTime?
  wwcCheckExpiry            DateTime?
  approvalStatus            String              @default("PENDING")
  workingHours              Json?
  policyExceptionCount      Int                 @default(0)
  allowedDurations          Json?
  bookingBufferMinutes      Int?
  enableTravelTime          Boolean             @default(false)
  travelTimeMinutes         Int?
  payoutMethod              String              @default("stripe_connect")
  bankBsb                   String?
  bankAccount               String?
  bankAccountName           String?
  abn                       String?
  abnVerified               Boolean             @default(false)
  abnStatus                 String?
  abnEntityName             String?
  abnVerifiedAt             DateTime?
  abnVerifiedBy             String?
  gstRegistered             Boolean             @default(false)
  withholdingTaxRate        Float               @default(47)
  syncGoogleCalendar        Boolean             @default(false)
  googleAccessToken         String?
  googleRefreshToken        String?
  googleTokenExpiry         DateTime?
  googleCalendarId          String?
  calendarBufferMode        String?
  whatsapp                  String?
  instagram                 String?
  facebook                  String?
  yearsExperience           Int?
  domainVerified            Boolean             @default(false)
  domainVerifiedAt          DateTime?
  customSlug                String?
  offersTestPackage         Boolean             @default(false)
  testPackageDuration       Int?
  testPackageIncludes       Json?
  testPackagePrice          Float?
  baseAddressLat            Float?
  baseAddressLng            Float?
  baseLatitude              Float?
  baseLongitude             Float?
  acceptingBookings         Boolean             @default(true)
  chargesEnabled            Boolean             @default(false)
  payoutHold                Boolean             @default(false)
  payoutHoldReason          String?
  payoutsEnabled            Boolean             @default(false)
  lessonPackages            Json?
  videoUrl                  String?
  specialties               String?
  voiceLine                 String?
  voiceLineStatus           String              @default("NONE")
  voiceLineSid              String?
  suburb                    String?
  state                     String?
  postcode                  String?
  timezone                  String?
  businessName              String?
  bookings                  Booking[]
  clients                   Client[]
  user                      User?               @relation(fields: [userId], references: [id])
  expenses                  InstructorExpense[]
  pdaBookings               PDATestBooking[]
  pdaConfigs                PDATestConfig[]
  slotReservations          SlotReservation[]
  subscriptions             Subscription[]
  cardOrders                CardOrder[]
  voiceLineRecord           TwilioPhoneNumber?  @relation("AssignedToInstructor")

  @@index([state, suburb])
}

model TwilioPhoneNumber {
  id           String      @id @default(cuid())
  sid          String      @unique
  phoneNumber  String      @unique
  friendlyName String?
  areaCode     String?
  status       String      @default("AVAILABLE")
  assignedTo   String?     @unique
  assignedAt   DateTime?   @db.Timestamptz(6)
  assignedBy   String?
  releasedAt   DateTime?   @db.Timestamptz(6)
  releasedBy   String?
  notes        String?
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  instructor   Instructor? @relation("AssignedToInstructor", fields: [assignedTo], references: [id], onUpdate: NoAction)

  @@index([status])
  @@index([assignedTo])
}

model InstructorExpense {
  id           String     @id @default(cuid())
  instructorId String
  date         DateTime
  category     String
  description  String
  amount       Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
}

model SlotReservation {
  id           String     @id @default(cuid())
  instructorId String
  sessionId    String
  startTime    DateTime
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  endTime      DateTime
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, expiresAt])
  @@index([sessionId])
}

model PlatformRateChange {
  id            String    @id @default(cuid())
  tier          String
  field         String
  currentRate   Float
  newRate       Float
  effectiveDate DateTime
  reason        String
  status        String    @default("PENDING")
  notifiedAt    DateTime?
  appliedAt     DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Booking {
  id                    String        @id @default(cuid())
  instructorId          String
  clientId              String?
  clientName            String?
  clientPhone           String?
  bookingType           String?
  status                String        @default("PENDING")
  startTime             DateTime?
  endTime               DateTime?
  duration              Float?
  price                 Float         @default(0)
  platformFee           Float         @default(0)
  instructorPayout      Float         @default(0)
  commissionRate        Float         @default(0)
  isPaid                Boolean       @default(false)
  paidAt                DateTime?
  paymentCaptured       Boolean       @default(false)
  paymentCapturedAt     DateTime?
  paymentIntentId       String?
  pickupAddress         String?
  pickupLatitude        Float?
  pickupLongitude       Float?
  dropoffAddress        String?
  dropoffLatitude       Float?
  dropoffLongitude      Float?
  notes                 String?
  isFirstBooking        Boolean       @default(false)
  isPackageBooking      Boolean       @default(false)
  parentBookingId       String?
  packageHours          Float?
  packageHoursUsed      Float         @default(0)
  packageHoursRemaining Float?
  packageTotalPaid      Float?
  packageExpiryDate     DateTime?
  packageStatus         String?
  createdBy             String?
  originalStartTime     DateTime?
  isNonRefundable       Boolean       @default(false)
  rescheduledFrom       Json?
  rescheduleCount       Int           @default(0)
  deletedAt             DateTime?
  deletedBy             String?
  noShowParty           String?
  googleCalendarEventId String?
  lessonFeedback        Int[]         @default([])
  instructorNotes       String?
  feedbackGivenAt       DateTime?
  studentStrengths      Int[]         @default([])
  focusAreas            Int[]         @default([])
  performanceScore      Int?
  // Assessment type — controls how feedback is interpreted and displayed
  // COACHING (default): everyday lesson, no score, topics + coaching notes only
  // MOCK: formal mock PDA, score + pass/fail computed across all categories
  // OFFICIAL: future — accredited assessor result (not yet active)
  assessmentType        String        @default("COACHING")
  lessonTopics          String?       // Comma-separated topics covered e.g. "Roundabouts,Parking"
  passed                Boolean?      // null for COACHING, true/false for MOCK/OFFICIAL
  clientRating          Int?
  clientReview          String?
  reviewGivenAt         DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  clientEmail           String?
  lockedDiscountPct     Float?
  lockedHourlyRate      Float?
  offlineAmountPaid     Float?
  offlinePaymentMethod  String?
  source                String        @default("platform")
  cancelledAt           DateTime?
  actualDuration        Int?
  checkInBy             String?
  checkInLocation       String?
  checkInPhoto          String?
  checkInTime           DateTime?
  checkOutBy            String?
  checkOutLocation      String?
  checkOutPhoto         String?
  checkOutTime          DateTime?
  smsCheckOutSent       Boolean       @default(false)
  paymentToken          String?
  whiteboardSketchUrl   String?
  timezone              String?
  client                Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  instructor            Instructor    @relation(fields: [instructorId], references: [id])
  transactions          Transaction[]

  @@index([instructorId, clientRating])
}

model Transaction {
  id                    String              @id @default(cuid())
  bookingId             String?
  instructorId          String
  type                  String
  amount                Float
  platformFee           Float               @default(0)
  instructorPayout      Float               @default(0)
  commissionRate        Float               @default(0)
  status                String              @default("PENDING")
  description           String?
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeTransferId      String?
  taxWithheld           Float               @default(0)
  gstAmount             Float               @default(0)
  metadata              Json?
  resolutionGroupId     String?
  resolutionStatus      String?
  processedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  payoutTransactions    PayoutTransaction[]
  booking               Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model ClientWallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  balance      Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String       @id @default(cuid())
  walletId    String
  amount      Float
  type        String
  description String?
  status      String       @default("PENDING")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  metadata    Json?
  bookingId   String?
  wallet      ClientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Message {
  id           String   @id @default(cuid())
  callerNumber String
  callerName   String?
  message      String
  timestamp    DateTime @default(now())
  status       String
}

model Subscription {
  id                   String     @id @default(cuid())
  instructorId         String
  tier                 String
  status               String     @default("ACTIVE")
  billingCycle         String     @default("monthly")
  monthlyAmount        Float
  stripeSubscriptionId String?
  stripeCustomerId     String?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean    @default(false)
  trialEndsAt          DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  instructor           Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  type          String
  title         String
  message       String
  link          String?
  isRead        Boolean  @default(false)
  metadata      Json?
  createdAt     DateTime @default(now())
  reminderStage String?
  channel       String?
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  actorId      String
  actorRole    String
  targetType   String
  targetId     String
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())
}

model Payout {
  id               String              @id @default(cuid())
  instructorId     String
  status           String              @default("PENDING")
  grossAmount      Float
  taxWithheld      Float               @default(0)
  gstAmount        Float               @default(0)
  netAmount        Float
  payoutMethod     String
  stripeAccountId  String?
  stripeTransferId String?
  bankReference    String?
  sentAt           DateTime?
  sentBy           String?
  confirmedAt      DateTime?
  confirmedBy      String?
  idempotencyKey   String              @unique
  failureReason    String?
  holdReason       String?
  retryCount       Int                 @default(0)
  approvedBy       String?
  approvedAt       DateTime?
  paidAt           DateTime?
  payoutRef        String              @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  transactions     PayoutTransaction[]
}

model PayoutTransaction {
  id            String      @id @default(cuid())
  payoutId      String
  transactionId String
  payout        Payout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model PlatformLedger {
  id               String   @id @default(cuid())
  key              String   @unique @default("default")
  totalCollected   Float    @default(0)
  totalReserved    Float    @default(0)
  totalPaidOut     Float    @default(0)
  totalRefunded    Float    @default(0)
  totalTaxWithheld Float    @default(0)
  updatedAt        DateTime @updatedAt
}

model LedgerEntry {
  id            String   @id @default(cuid())
  type          String
  amount        Float
  currency      String   @default("AUD")
  referenceId   String
  referenceType String
  instructorId  String?
  description   String?
  metadata      Json?
  createdAt     DateTime @default(now())
}

model WebhookEvent {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  eventType      String
  stripeEventId  String
  metadata       Json?
  processedAt    DateTime @default(now())
}

model PlatformSettings {
  id                          String   @id @default(cuid())
  key                         String   @unique @default("default")
  basicCommissionRate         Float    @default(15)
  proCommissionRate           Float    @default(12)
  studioCommissionRate        Float    @default(11)
  businessCommissionRate      Float    @default(10)
  basicNewStudentBonus        Float    @default(8)
  proNewStudentBonus          Float    @default(10)
  businessNewStudentBonus     Float    @default(12)
  platformFeePercentage       Float    @default(3.6)
  package6Discount            Float    @default(5)
  package10Discount           Float    @default(10)
  package15Discount           Float    @default(12)
  discountPaidBy              String   @default("shared")
  drivingTestPackagePrice     Float    @default(225)
  cancellationFee             Float    @default(0)
  lateCancellationWindowHours Float    @default(24)
  noShowPenaltyAmount         Float    @default(0)
  walletTopUpMin              Float    @default(10)
  walletTopUpMax              Float    @default(500)
  gstEnabled                  Boolean  @default(true)
  gstRate                     Float    @default(10)
  withholdingTaxRate          Float    @default(47)
  peakSurchargeEnabled        Boolean  @default(false)
  peakSurchargePercent        Float    @default(0)
  updatedAt                   DateTime @updatedAt
  updatedBy                   String?
  // RBAC configurable limits — adjustable by SUPER_ADMIN via settings API
  maxAdminCreditAmount        Float    @default(500)
  maxAdminDeductAmount        Float    @default(500)
}

model ReconciliationReport {
  id               String    @id @default(cuid())
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  status           String
  windowStart      DateTime
  windowEnd        DateTime
  paymentsChecked  Int       @default(0)
  missingPayments  Int       @default(0)
  transfersChecked Int       @default(0)
  missingTransfers Int       @default(0)
  stuckPayouts     Int       @default(0)
  metadata         Json?
  createdAt        DateTime  @default(now())
}

model AvailabilityException {
  id            String   @id @default(cuid())
  instructorId  String
  label         String?
  exceptionDate DateTime
  startTime     String
  endTime       String
  allDay        Boolean  @default(false)
  createdAt     DateTime @default(now())
  reason        String?

  @@index([instructorId, exceptionDate])
}

model LearningContent {
  id           String   @id @default(cuid())
  title        String
  description  String
  tipText      String
  videoUrl     String?
  thumbnailUrl String?
  category     String
  difficulty   String   @default("basic")
  pdaCodes     Int[]    @default([])
  durationSec  Int?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TestCentre {
  id          String                @id @default(cuid())
  name        String                @unique
  address     String
  suburb      String
  state       String                @default("WA")
  region      String?
  lat         Float?
  lng         Float?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  pdaConfigs  PDAConfigTestCentre[]
  pdaBookings PDATestBooking[]
}

model PDATestConfig {
  id              String                @id @default(cuid())
  instructorId    String
  name            String
  durationMinutes Int
  price           Float
  discountPercent Float?
  includes        Json?
  notes           String?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  testCentres     PDAConfigTestCentre[]
  bookings        PDATestBooking[]
  instructor      Instructor            @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
  @@index([isActive])
}

model PDAConfigTestCentre {
  id           String        @id @default(cuid())
  pdaConfigId  String
  testCentreId String
  pdaConfig    PDATestConfig @relation(fields: [pdaConfigId], references: [id], onDelete: Cascade)
  testCentre   TestCentre    @relation(fields: [testCentreId], references: [id], onDelete: Cascade)

  @@unique([pdaConfigId, testCentreId])
  @@index([testCentreId])
}

model PDATestBooking {
  id              String        @id @default(cuid())
  instructorId    String
  clientId        String
  configId        String
  testCentreId    String
  testDate        DateTime
  testTime        String
  price           Float
  discountPercent Float?
  status          String        @default("PENDING")
  result          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  notes           String?
  parentBookingId String?
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  config          PDATestConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  instructor      Instructor    @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  testCentre      TestCentre    @relation(fields: [testCentreId], references: [id])

  @@index([instructorId, testDate])
  @@index([clientId])
  @@index([configId])
  @@index([testCentreId])
  @@index([status])
}

model BookingIdempotencyKey {
  key       String   @id
  bookingId String
  response  Json
  createdAt DateTime @default(now())
  email     String

  @@index([createdAt])
  @@index([email])
}

model CronHealth {
  id         String   @id @default(cuid())
  jobName    String   @unique
  lastRunAt  DateTime
  lastStatus String   @default("OK")
  lastError  String?
  runCount   Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@index([jobName])
}

model StripeDispute {
  id                    String    @id @default(cuid())
  stripeDisputeId       String    @unique
  stripeChargeId        String
  stripePaymentIntentId String?
  bookingId             String?
  instructorId          String?
  amount                Float
  currency              String    @default("AUD")
  reason                String
  status                String
  payoutFrozen          Boolean   @default(false)
  adjustmentCreated     Boolean   @default(false)
  resolvedAt            DateTime?
  metadata              Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([bookingId])
  @@index([instructorId])
  @@index([stripePaymentIntentId])
}

model StaffMember {
  id                     String     @id @default(cuid())
  userId                 String     @unique
  name                   String
  email                  String     @unique
  department             String
  isActive               Boolean    @default(true)
  isSupervisor           Boolean    @default(false)
  currentLoad            Int        @default(0)
  maxCapacity            Int        @default(10)
  tasksCompleted         Int        @default(0)
  avgResolutionTimeHours Float?
  satisfactionScore      Float?
  skills                 Json?
  // RBAC: permissions[] is authoritative. Empty = no access. SUPER_ADMIN bypasses.
  // Legacy flags kept for UI only  NOT read by any API permission check.
  permissions            String[]   @default([])
  canApproveRefunds      Boolean    @default(false)
  canOverridePolicy      Boolean    @default(false)
  canAccessFinancials    Boolean    @default(false)
  maxRefundAmount        Float      @default(100)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  user                   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks          Task[]     @relation("AssignedTasks")
  taskNotes              TaskNote[]

  @@index([department, isActive])
}

model Task {
  id                   String       @id @default(cuid())
  type                 String
  category             String
  priority             String
  status               String       @default("OPEN")
  title                String
  description          String
  instructorId         String?
  clientId             String?
  bookingId            String?
  userId               String?
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  assignedToId         String?
  assignedAt           DateTime?
  autoAssigned         Boolean      @default(false)
  dueDate              DateTime?
  financialAmount      Float?
  financialImpact      Json?
  requiresApproval     Boolean      @default(false)
  firstResponseAt      DateTime?
  slaBreached          Boolean      @default(false)
  slaBreachReason      String?
  resolutionTimeHours  Float?
  escalatedAt          DateTime?
  escalatedTo          String?
  escalationReason     String?
  escalationCount      Int          @default(0)
  autoEscalated        Boolean      @default(false)
  resolution           String?
  resolvedAt           DateTime?
  resolvedBy           String?
  closedAt             DateTime?
  closedBy             String?
  linkedEntityVerified Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  assignedTo           StaffMember? @relation("AssignedTasks", fields: [assignedToId], references: [id])
  notes                TaskNote[]

  @@index([status, priority])
  @@index([instructorId])
  @@index([bookingId])
  @@index([assignedToId])
}

model TaskNote {
  id          String      @id @default(cuid())
  taskId      String
  staffId     String
  note        String
  isInternal  Boolean     @default(true)
  attachments Json?
  createdAt   DateTime    @default(now())
  staff       StaffMember @relation(fields: [staffId], references: [id])
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model FinancialLedger {
  id             String   @id @default(cuid())
  debitAccount   String
  creditAccount  String
  amount         Float
  description    String
  idempotencyKey String   @unique
  bookingId      String?
  transactionId  String?
  payoutId       String?
  userId         String?
  instructorId   String?
  metadata       Json?
  createdBy      String   @default("SYSTEM")
  createdAt      DateTime @default(now())

  @@index([bookingId])
  @@index([instructorId])
  @@index([userId])
  @@index([createdAt])
}

// DeviceToken — stores mobile push notification tokens for Expo/FCM/APNs.
// Used by the mobile push notification service to target specific devices.
// Each token is unique; upsert on registration to avoid duplicates.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   // "ios" | "android" | "web"
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
}

model LoginDevice {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String   // hash of user-agent + IP
  lastUsedAt  DateTime @default(now())
  firstSeenAt DateTime @default(now())
  ipAddress   String
  userAgent   String
  location    String?  // "Perth, WA" from IP geolocation (future)
  trusted     Boolean  @default(false)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([lastUsedAt])
}

model CardOrder {
  id           String   @id @default(cuid())
  instructorId String
  quantity     Int
  suburbs      String?
  notes        String?
  status       String   @default("PENDING") // PENDING | APPROVED | PRINTING | READY | DELIVERED | CANCELLED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
  @@index([status])
}
